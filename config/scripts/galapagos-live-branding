#!/bin/sh
set -u

# Only affect the live "Try Galapagos" session.
if [ ! -f /cdrom/casper/filesystem.squashfs ]; then
    exit 0
fi

WALLPAPER="/usr/share/backgrounds/galapagos/galapagos-wallpaper.svg"

if command -v gsettings >/dev/null 2>&1 && [ -f "$WALLPAPER" ]; then
    gsettings set org.cinnamon.desktop.background picture-uri "file://$WALLPAPER" || true
    gsettings set org.cinnamon.desktop.background picture-uri-dark "file://$WALLPAPER" || true
    gsettings set org.cinnamon.desktop.background picture-options "zoom" || true
fi

# Make sure the old Debian live wallpaper is not selected by Cinnamon.
exit 0

# Use the Galapagos logo for the live user's account avatar in Cinnamon/GNOME
# account settings and as a cross-desktop fallback.
AVATAR_SOURCE="/etc/calamares/branding/galapagos/logo.svg"
ACCOUNT_ICON="/var/lib/AccountsService/icons/vboxuser.svg"
ACCOUNT_FILE="/var/lib/AccountsService/users/vboxuser"

if [ -f "$AVATAR_SOURCE" ]; then
    mkdir -p /var/lib/AccountsService/icons /var/lib/AccountsService/users
    cp -f "$AVATAR_SOURCE" "$ACCOUNT_ICON"
    if [ -f "$ACCOUNT_FILE" ]; then
        if grep -q '^Icon=' "$ACCOUNT_FILE"; then
            sed -i "s|^Icon=.*$|Icon=$ACCOUNT_ICON|" "$ACCOUNT_FILE"
        else
            printf '\nIcon=%s\n' "$ACCOUNT_ICON" >> "$ACCOUNT_FILE"
        fi
    else
        printf '[User]\nIcon=%s\n' "$ACCOUNT_ICON" > "$ACCOUNT_FILE"
    fi
    if [ -d "$HOME" ]; then
        cp -f "$AVATAR_SOURCE" "$HOME/.face"
    fi
fi

# Refresh icon metadata so Cinnamon sees the current launcher artwork.
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

# Cinnamon can keep launcher trust metadata separately from the .desktop file.
# Mark the Galapagos installer launcher as trusted in the live session.
INSTALLER_DESKTOP="$HOME/Desktop/Galapagos Linux'u Kur.desktop"
if [ -f "$INSTALLER_DESKTOP" ] && command -v gio >/dev/null 2>&1; then
    gio set "$INSTALLER_DESKTOP" metadata::trusted true >/dev/null 2>&1 || true
fi
